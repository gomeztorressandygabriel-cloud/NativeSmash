diff --git a/src/dxvk/dxvk_android_cache.h b/src/dxvk/dxvk_android_cache.h
new file mode 100644
index 0000000..4e2e226
--- /dev/null
+++ b/src/dxvk/dxvk_android_cache.h
@@ -0,0 +1,102 @@
+#pragma once
+
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <pthread.h>
+#include <thread>
+#include <vector>
+
+#include "../vulkan/vulkan_loader.h"
+
+namespace dxvk {
+
+  /**
+   * NativeSmash on Android: the VkPipelineCache every pipeline is made with. It starts from the file named by
+   * NATIVESMASH_PIPELINE_CACHE (if there is one) and is written back, when it has grown, every 20 seconds: the
+   * phone's driver then compiles a pipeline it has made in an earlier run in a few milliseconds, not tens.
+   * Elsewhere, and without the variable, it is VK_NULL_HANDLE (no cache), as before.
+   */
+  template<typename T>
+  VkPipelineCache dxvkPipelineCache(const T& vk) {
+#ifdef __ANDROID__
+    static std::once_flag once;
+    static VkPipelineCache cache = VK_NULL_HANDLE;
+
+    std::call_once(once, [&vk] () {
+      const char* env = std::getenv("NATIVESMASH_PIPELINE_CACHE");
+
+      if (!env || !*env)
+        return;
+
+      std::string path(env);
+      std::vector<char> data;
+
+      if (FILE* f = std::fopen(path.c_str(), "rb")) {
+        std::fseek(f, 0, SEEK_END);
+        long size = std::ftell(f);
+        std::fseek(f, 0, SEEK_SET);
+
+        if (size > 0) {
+          data.resize(size_t(size));
+          if (std::fread(data.data(), 1, data.size(), f) != data.size())
+            data.clear();
+        }
+
+        std::fclose(f);
+      }
+
+      VkPipelineCacheCreateInfo info = { VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO };
+      info.initialDataSize = data.size();
+      info.pInitialData    = data.empty() ? nullptr : data.data();
+
+      if (vk->vkCreatePipelineCache(vk->device(), &info, nullptr, &cache)) {
+        info.initialDataSize = 0;
+        info.pInitialData    = nullptr;
+
+        if (vk->vkCreatePipelineCache(vk->device(), &info, nullptr, &cache))
+          cache = VK_NULL_HANDLE;
+      }
+
+      if (!cache)
+        return;
+
+      T keep = vk;
+      VkPipelineCache handle = cache;
+
+      std::thread([keep, handle, path] () {
+        pthread_setname_np(pthread_self(), "ns-pipe-cache");
+        size_t last = 0;
+
+        for (;;) {
+          std::this_thread::sleep_for(std::chrono::seconds(20));
+
+          size_t size = 0;
+          if (keep->vkGetPipelineCacheData(keep->device(), handle, &size, nullptr) || !size || size == last)
+            continue;
+
+          std::vector<char> out(size);
+          if (keep->vkGetPipelineCacheData(keep->device(), handle, &size, out.data()) < 0)
+            continue;
+
+          std::string tmp = path + ".tmp";
+          if (FILE* f = std::fopen(tmp.c_str(), "wb")) {
+            bool ok = std::fwrite(out.data(), 1, size, f) == size;
+            std::fclose(f);
+
+            if (ok && !std::rename(tmp.c_str(), path.c_str()))
+              last = size;
+          }
+        }
+      }).detach();
+    });
+
+    return cache;
+#else
+    (void) vk;
+    return VK_NULL_HANDLE;
+#endif
+  }
+
+}
