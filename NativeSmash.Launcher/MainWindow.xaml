<Window x:Class="NativeSmash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NativeSmash" Width="1240" Height="740" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/nativesmash-512.png">
  <Window.Resources>
    <Color x:Key="AccentA">#FF6D7DFF</Color>
    <Color x:Key="AccentB">#FFA66BFF</Color>
    <SolidColorBrush x:Key="Ink" Color="#FFF2F4FB"/>
    <SolidColorBrush x:Key="Muted" Color="#FF9AA1BC"/>
    <SolidColorBrush x:Key="Veil" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Edge" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Good" Color="#FF3DDC97"/>
    <SolidColorBrush x:Key="Warn" Color="#FFFFB86B"/>
    <SolidColorBrush x:Key="Discord" Color="#FF5865F2"/>
    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="{StaticResource AccentA}" Offset="0"/><GradientStop Color="{StaticResource AccentB}" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,18,0,8"/></Style>
    <Style x:Key="Help" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8,0,0"/><Setter Property="LineHeight" Value="19"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="20"/><Setter Property="Background" Value="#0FFFFFFF"/><Setter Property="BorderBrush" Value="#1FFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="26,22,26,24"/><Setter Property="Margin" Value="0,22,0,0"/></Style>
    <Style x:Key="SideCard" TargetType="Border"><Setter Property="CornerRadius" Value="18"/><Setter Property="Background" Value="#0FFFFFFF"/><Setter Property="BorderBrush" Value="#1FFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20,16,20,18"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
    <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,24,0,10"/></Style>
    <Style x:Key="Title" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="SemiBold"/></Style>

    <!-- a side menu entry -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="b" CornerRadius="12" Padding="16,10" Background="Transparent">
          <Grid><Border x:Name="bar" Width="4" CornerRadius="2" HorizontalAlignment="Left" Margin="-8,2" Background="{StaticResource Accent}" Opacity="0"/>
            <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
              <TextBlock x:Name="ico" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Opacity="0.75"/>
              <ContentPresenter VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/></StackPanel></Grid></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Tag" Value="home"><Setter TargetName="ico" Property="Text" Value="&#xE768;"/></Trigger>
          <Trigger Property="Tag" Value="online"><Setter TargetName="ico" Property="Text" Value="&#xE774;"/></Trigger>
          <Trigger Property="Tag" Value="pads"><Setter TargetName="ico" Property="Text" Value="&#xE7FC;"/></Trigger>
          <Trigger Property="Tag" Value="video"><Setter TargetName="ico" Property="Text" Value="&#xE7F4;"/></Trigger>
          <Trigger Property="Tag" Value="mods"><Setter TargetName="ico" Property="Text" Value="&#xE74C;"/></Trigger>
          <Trigger Property="Tag" Value="shaders"><Setter TargetName="ico" Property="Text" Value="&#xE790;"/></Trigger>
          <Trigger Property="Tag" Value="game"><Setter TargetName="ico" Property="Text" Value="&#xE713;"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#12FFFFFF"/><Setter TargetName="ico" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/><Setter TargetName="bar" Property="Opacity" Value="1"/><Setter TargetName="ico" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- one of several choices -->
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="b" CornerRadius="12" Padding="16,10" Background="{StaticResource Veil}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
          <ContentPresenter HorizontalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="b" Property="BorderBrush" Value="#66FFFFFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- an on/off switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,8,0,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Border x:Name="track" Width="46" Height="26" CornerRadius="13" Background="#33FFFFFF" VerticalAlignment="Center">
            <Ellipse x:Name="knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3,0"/></Border>
          <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="CaretBrush" Value="White"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="b" CornerRadius="12" Background="{StaticResource Veil}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="14,10">
          <ScrollViewer x:Name="PART_ContentHost"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#FF8E9BFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/></Track.IncreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border Background="#33FFFFFF" CornerRadius="5" Margin="2,0"/>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Volume" TargetType="Slider">
      <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="TickFrequency" Value="5"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Height="26">
          <Border Height="6" CornerRadius="3" Background="#33FFFFFF" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" CornerRadius="3" Background="{StaticResource Accent}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="20" Height="20" Fill="White"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Soft" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="12" Padding="18,11" Background="{StaticResource Veil}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
          <ContentPresenter HorizontalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#26FFFFFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Soft}">
      <Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="10" Padding="12,6" Background="{StaticResource Veil}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
          <ContentPresenter HorizontalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#26FFFFFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="#FFB9C2FF"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <ContentPresenter x:Name="c" TextBlock.Foreground="{TemplateBinding Foreground}"/>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DiscordBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="12" Padding="16,10" Background="{StaticResource Discord}" BorderBrush="#55FFFFFF" BorderThickness="1">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Path Data="M20.3 4.4A19.6 19.6 0 0 0 15.4 2.9l-.6 1.3a18.2 18.2 0 0 0-5.6 0L8.6 2.9a19.5 19.5 0 0 0-4.9 1.5C.6 9.1-.3 13.6.2 18.1a19.8 19.8 0 0 0 6 3l1.3-2.1c-.7-.3-1.4-.6-2-1l.5-.4a14 14 0 0 0 12 0l.5.4c-.6.4-1.3.7-2 1l1.3 2.1a19.7 19.7 0 0 0 6-3c.5-5.2-.9-9.7-3.5-13.7ZM8 15.3c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z"
                  Fill="White" Width="18" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ContentPresenter VerticalAlignment="Center" TextBlock.Foreground="White"/></StackPanel></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- minimize and close -->
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="10" Background="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#33FFFFFF"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CloseWin" TargetType="Button" BasedOn="{StaticResource WinBtn}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="10" Background="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#CCE5484D"/><Setter Property="Foreground" Value="White"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#FFC93A40"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="AccentBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="14" Background="{StaticResource Accent}" Padding="24,12" BorderBrush="#55FFFFFF" BorderThickness="1">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="White"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PlayBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
          <Border x:Name="glow" CornerRadius="32" Background="{StaticResource Accent}" Opacity="0.55"><Border.Effect><BlurEffect Radius="26"/></Border.Effect></Border>
          <Border x:Name="b" CornerRadius="32" Background="{StaticResource Accent}" Padding="56,18" BorderBrush="#55FFFFFF" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="White"/></Border></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="glow" Property="Opacity" Value="0.9"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.14"/>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06"/>
              <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06"/></Storyboard></BeginStoryboard></Trigger.EnterActions></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Background" Value="#22FFFFFF"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid><Border CornerRadius="3" Background="{TemplateBinding Background}"/>
          <Border x:Name="PART_Track"/>
          <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell" CornerRadius="26" BorderThickness="1" Margin="22">
    <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#55FFFFFF" Offset="0"/><GradientStop Color="#1AFFFFFF" Offset="0.45"/><GradientStop Color="#33A66BFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF141935" Offset="0"/><GradientStop Color="#FF0E1124" Offset="0.55"/><GradientStop Color="#FF080A15" Offset="1"/></LinearGradientBrush></Border.Background>
    <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.65"/></Border.Effect>
    <Grid>
      <Ellipse x:Name="Aura" Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-170,-120,0" IsHitTestVisible="False" Opacity="0.55">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#886D7DFF" Offset="0"/><GradientStop Color="#00A66BFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- side menu -->
        <Border Grid.Column="0" Background="#0DFFFFFF" CornerRadius="26,0,0,26" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
          <Grid Margin="22,26,22,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/nativesmash-512.png" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="NativeSmash" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/></StackPanel>
              <TextBlock x:Name="Tagline" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,24" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Row="1">
              <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" GroupName="nav" Tag="home"/>
              <RadioButton x:Name="NavOnline" Style="{StaticResource Nav}" GroupName="nav" Tag="online"/>
              <RadioButton x:Name="NavPads" Style="{StaticResource Nav}" GroupName="nav" Tag="pads"/>
              <RadioButton x:Name="NavVideo" Style="{StaticResource Nav}" GroupName="nav" Tag="video"/>
              <RadioButton x:Name="NavMods" Style="{StaticResource Nav}" GroupName="nav" Tag="mods"/>
              <RadioButton x:Name="NavShaders" Style="{StaticResource Nav}" GroupName="nav" Tag="shaders"/>
              <RadioButton x:Name="NavGame" Style="{StaticResource Nav}" GroupName="nav" Tag="game"/>
            </StackPanel>
            <!-- the Discord account, small -->
            <StackPanel Grid.Row="2">
              <Border x:Name="SideMe" CornerRadius="14" Background="#0DFFFFFF" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="12,10" Margin="0,0,0,12" Cursor="Hand" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <Grid Width="32" Height="32"><Ellipse Fill="{StaticResource Discord}"/><Ellipse x:Name="SideAvatar"/></Grid>
                  <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SideName" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                    <TextBlock x:Name="SideRank" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel></Border>
              <TextBlock x:Name="Footer" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- pages -->
        <Grid Grid.Column="1" x:Name="Pages" Margin="44,38,40,30">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-22,-24,0" Panel.ZIndex="5">
            <Button x:Name="MinBtn" Style="{StaticResource WinBtn}" Content="&#xE921;"/>
            <Button x:Name="CloseBtn" Style="{StaticResource CloseWin}" Content="&#xE8BB;"/>
          </StackPanel>

          <!-- ============ HOME ============ -->
          <Grid x:Name="PageHome">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <Border x:Name="UpdBanner" Visibility="Collapsed" CornerRadius="14" Background="#22A66BFF" BorderBrush="#55A66BFF" BorderThickness="1" Padding="16,6,6,6" HorizontalAlignment="Left" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal"><TextBlock x:Name="UpdBannerText" Foreground="{StaticResource Ink}" FontSize="14" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Button x:Name="UpdBannerBtn" Style="{StaticResource Small}"/></StackPanel></Border>
              <TextBlock x:Name="Kicker" Style="{StaticResource Eyebrow}" FontSize="12"/>
              <TextBlock x:Name="PlayTitle" Style="{StaticResource Title}" FontSize="42" Margin="0,10,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="PlayHelp" Style="{StaticResource Help}" FontSize="15" MaxWidth="520" HorizontalAlignment="Left"/>
              <WrapPanel x:Name="StatusChips" Margin="0,22,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                <Button x:Name="PlayBtn" Style="{StaticResource PlayBtn}"/>
                <Button x:Name="InstallBtn" Style="{StaticResource Soft}" Margin="18,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
              </StackPanel>
              <CheckBox x:Name="VanillaBox" Style="{StaticResource Switch}" Margin="0,30,0,0"/>
              <CheckBox x:Name="DirectBox" Style="{StaticResource Switch}" Margin="0,12,0,0"/>
            </StackPanel>

            <!-- the right column: account, players online, ranking -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="0,24,0,0">
              <StackPanel>
                <Border Style="{StaticResource SideCard}">
                  <StackPanel>
                    <TextBlock x:Name="AccEyebrow" Style="{StaticResource Eyebrow}"/>
                    <StackPanel x:Name="AccOut" Margin="0,10,0,0">
                      <Button x:Name="AccSignIn" Style="{StaticResource DiscordBtn}"/>
                      <TextBlock x:Name="AccOutHelp" Style="{StaticResource Help}" FontSize="12"/></StackPanel>
                    <Grid x:Name="AccIn" Margin="0,10,0,0" Visibility="Collapsed" Cursor="Hand">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Grid Width="46" Height="46"><Ellipse Fill="{StaticResource Discord}"/><Ellipse x:Name="AccAvatar"/></Grid>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AccName" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="AccRank" Foreground="#FFB9C2FF" FontSize="12" Margin="0,2,0,0"/></StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource SideCard}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="LobbyDot" Width="8" Height="8" Fill="{StaticResource Good}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock x:Name="LobbyEyebrow" Style="{StaticResource Eyebrow}"/></StackPanel>
                    <TextBlock x:Name="LobbyBig" Foreground="{StaticResource Ink}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock x:Name="LobbySmall" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource SideCard}">
                  <StackPanel>
                    <Grid><TextBlock x:Name="BoardEyebrow" Style="{StaticResource Eyebrow}"/>
                      <TextBlock x:Name="BoardRanked" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right"/></Grid>
                    <StackPanel x:Name="BoardList" Margin="0,10,0,0"/>
                    <TextBlock x:Name="BoardEmpty" Style="{StaticResource Help}" FontSize="12" Visibility="Collapsed"/>
                    <Button x:Name="BoardLink" Style="{StaticResource Link}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- ============ ONLINE ============ -->
          <ScrollViewer x:Name="PageOnline" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
            <StackPanel>
              <TextBlock x:Name="OnlineTitle" Style="{StaticResource Title}"/>
              <TextBlock x:Name="OnlineHelp" Style="{StaticResource Help}" FontSize="14" MaxWidth="680" HorizontalAlignment="Left"/>

              <!-- Discord account and GSP -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="DcTitle" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="DcHelp" Style="{StaticResource Help}" MaxWidth="640" HorizontalAlignment="Left"/>
                  <StackPanel x:Name="DcOut" Margin="0,16,0,0" Orientation="Horizontal">
                    <Button x:Name="DcSignIn" Style="{StaticResource DiscordBtn}"/>
                    <Button x:Name="DcCancel" Style="{StaticResource Soft}" Margin="12,0,0,0" Visibility="Collapsed"/></StackPanel>
                  <StackPanel x:Name="DcIn" Visibility="Collapsed" Margin="0,16,0,0">
                    <Grid>
                      <StackPanel Orientation="Horizontal">
                        <Grid Width="56" Height="56"><Ellipse Fill="{StaticResource Discord}"/><Ellipse x:Name="DcAvatar"/></Grid>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                          <TextBlock x:Name="DcName" Foreground="{StaticResource Ink}" FontSize="20" FontWeight="SemiBold"/>
                          <TextBlock x:Name="DcRank" Foreground="#FFB9C2FF" FontSize="13" Margin="0,2,0,0"/></StackPanel></StackPanel>
                      <Button x:Name="DcSignOut" Style="{StaticResource Soft}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/>
                    </Grid>
                    <CheckBox x:Name="DcShown" Style="{StaticResource Switch}" Margin="0,18,0,0"/>
                    <TextBlock x:Name="GspLabel" Style="{StaticResource Section}"/>
                    <WrapPanel x:Name="GspList" MaxWidth="700" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="GspEmpty" Style="{StaticResource Help}" Visibility="Collapsed"/>
                  </StackPanel>
                  <TextBlock x:Name="DcError" Style="{StaticResource Help}" Foreground="{StaticResource Warn}" Visibility="Collapsed"/>
                </StackPanel>
              </Border>

              <!-- lobby -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="LobbyTitle" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="LobbyHelp" Style="{StaticResource Help}" MaxWidth="640" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="NameLabel" Style="{StaticResource Label}"/>
                  <TextBox x:Name="NameBox" Style="{StaticResource Field}" MaxLength="32" Width="360" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="LobbyLabel" Style="{StaticResource Label}"/>
                  <WrapPanel x:Name="LobbyChips"/>
                  <StackPanel x:Name="CodeRow">
                    <TextBlock x:Name="CodeLabel" Style="{StaticResource Label}"/>
                    <StackPanel Orientation="Horizontal">
                      <TextBox x:Name="CodeBox" Style="{StaticResource Field}" MaxLength="32" Width="260"/>
                      <Button x:Name="CodeNew" Style="{StaticResource Soft}" Margin="10,0,0,0"/>
                      <Button x:Name="CodeCopy" Style="{StaticResource Soft}" Margin="10,0,0,0"/></StackPanel>
                    <TextBlock x:Name="CodeHelp" Style="{StaticResource Help}" MaxWidth="600" HorizontalAlignment="Left"/></StackPanel>
                  <StackPanel x:Name="ServerRow">
                    <TextBlock x:Name="ServerLabel" Style="{StaticResource Label}"/>
                    <TextBox x:Name="ServerBox" Style="{StaticResource Field}" Width="360" HorizontalAlignment="Left"/></StackPanel>
                  <TextBlock x:Name="LobbyNote" Foreground="{StaticResource Warn}" FontSize="13" Margin="0,8,0,0" Visibility="Collapsed"/>
                  <CheckBox x:Name="DirectConn" Style="{StaticResource Switch}" Margin="0,22,0,0"/>
                  <TextBlock x:Name="DirectHelp" Style="{StaticResource Help}" MaxWidth="600" HorizontalAlignment="Left" Margin="60,4,0,0"/>
                  <Button x:Name="FirewallBtn" Style="{StaticResource Soft}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                  <TextBlock x:Name="FirewallHelp" Style="{StaticResource Help}" MaxWidth="600" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                </StackPanel>
              </Border>

              <!-- how to play online -->
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="HowTitle" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="HowText" Style="{StaticResource Help}" FontSize="14" MaxWidth="660" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ============ CONTROLLERS ============ -->
          <ScrollViewer x:Name="PagePads" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
            <StackPanel>
              <TextBlock x:Name="PadsTitle" Style="{StaticResource Title}"/>
              <WrapPanel x:Name="PadTabs" Margin="0,16,0,0"/>
              <StackPanel x:Name="KbSection">
                <TextBlock x:Name="KbLabel" Style="{StaticResource Label}"/>
                <WrapPanel x:Name="KbChips" MaxWidth="700" HorizontalAlignment="Left"/>
                <CheckBox x:Name="BackgroundBox" Style="{StaticResource Switch}" Margin="0,14,0,0"/>
                <TextBlock x:Name="MoveLabel" Style="{StaticResource Label}"/>
                <WrapPanel x:Name="MoveChips"/>
                <TextBlock x:Name="MoveHelp" Style="{StaticResource Help}" MaxWidth="660" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                <TextBlock x:Name="KeysTitle" Style="{StaticResource Section}" FontSize="17" Margin="0,28,0,2"/>
                <TextBlock x:Name="KeysHelp" Style="{StaticResource Help}" MaxWidth="660" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                <WrapPanel x:Name="KeyGrid" MaxWidth="760" HorizontalAlignment="Left"/>
                <TextBlock x:Name="KeysNote" Foreground="{StaticResource Warn}" FontSize="13" Margin="0,2,0,0"/>
                <WrapPanel Margin="0,14,0,0"><Button x:Name="ResetKeys" Style="{StaticResource Soft}"/><Button x:Name="OpenPads" Style="{StaticResource Soft}"/></WrapPanel>
              </StackPanel>
              <StackPanel x:Name="PadSection" Visibility="Collapsed">
                <TextBlock x:Name="PadPickLabel" Style="{StaticResource Label}"/>
                <WrapPanel x:Name="PadPickChips" MaxWidth="720" HorizontalAlignment="Left"/>
                <TextBlock x:Name="PadNone" Style="{StaticResource Help}" MaxWidth="640" HorizontalAlignment="Left"/>
                <StackPanel x:Name="PadBody" Visibility="Collapsed">
                  <TextBlock x:Name="PadWhere" Style="{StaticResource Help}" MaxWidth="660" HorizontalAlignment="Left"/>
                  <CheckBox x:Name="DpadBox" Style="{StaticResource Switch}" Margin="0,16,0,0"/>
                  <CheckBox x:Name="TauntBox" Style="{StaticResource Switch}" Margin="0,10,0,0"/>
                  <TextBlock x:Name="PadMapTitle" Style="{StaticResource Section}" FontSize="17" Margin="0,26,0,2"/>
                  <TextBlock x:Name="PadMapHelp" Style="{StaticResource Help}" MaxWidth="660" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                  <WrapPanel x:Name="PadMapGrid" MaxWidth="760" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="PadMapNote" Foreground="{StaticResource Warn}" FontSize="13" Margin="0,2,0,0"/>
                  <WrapPanel Margin="0,14,0,0"><Button x:Name="ResetPad" Style="{StaticResource Soft}"/><Button x:Name="OpenPads2" Style="{StaticResource Soft}"/></WrapPanel>
                </StackPanel>
              </StackPanel>
              <TextBlock x:Name="PadsHelp" Style="{StaticResource Help}" MaxWidth="640" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel>
          </ScrollViewer>

          <!-- ============ VIDEO AND SOUND ============ -->
          <ScrollViewer x:Name="PageVideo" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
            <StackPanel>
              <TextBlock x:Name="VideoTitle" Style="{StaticResource Title}"/>
              <TextBlock x:Name="VideoHelp" Style="{StaticResource Help}" FontSize="14" MaxWidth="680" HorizontalAlignment="Left"/>
              <TextBlock x:Name="WindowLabel" Style="{StaticResource Label}"/>
              <WrapPanel x:Name="WindowChips"/>
              <TextBlock x:Name="SizeLabel" Style="{StaticResource Label}" Margin="0,8,0,8"/>
              <WrapPanel x:Name="SizeChips" MaxWidth="720" HorizontalAlignment="Left"/>
              <TextBlock x:Name="ScaleLabel" Style="{StaticResource Label}" Margin="0,8,0,8"/>
              <WrapPanel x:Name="ScaleChips" MaxWidth="720" HorizontalAlignment="Left"/>
              <TextBlock x:Name="ScaleHelp" Style="{StaticResource Help}" MaxWidth="660" HorizontalAlignment="Left" Margin="0,0,0,0"/>
              <TextBlock x:Name="PacingLabel" Style="{StaticResource Label}"/>
              <WrapPanel x:Name="PacingChips"/>
              <TextBlock x:Name="PacingHelp" Style="{StaticResource Help}" MaxWidth="660" HorizontalAlignment="Left" Margin="0,0,0,0"/>
              <TextBlock x:Name="RendererLabel" Style="{StaticResource Label}"/>
              <WrapPanel x:Name="RendererChips"/>
              <TextBlock x:Name="RendererHelp" Style="{StaticResource Help}" MaxWidth="660" HorizontalAlignment="Left" Margin="0,0,0,0"/>
              <TextBlock x:Name="GpuLabel" Style="{StaticResource Label}"/>
              <WrapPanel x:Name="GpuChips" MaxWidth="720" HorizontalAlignment="Left"/>
              <CheckBox x:Name="OverlayBox" Style="{StaticResource Switch}" Margin="0,16,0,0"/>
              <CheckBox x:Name="CursorBox" Style="{StaticResource Switch}" Margin="0,12,0,0"/>
              <TextBlock x:Name="VolumeLabel" Style="{StaticResource Label}" Margin="0,26,0,8"/>
              <StackPanel Orientation="Horizontal">
                <Slider x:Name="VolumeSlider" Style="{StaticResource Volume}" Width="360"/>
                <TextBlock x:Name="VolumeValue" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" Width="50"/></StackPanel>
              <TextBlock x:Name="LangLabel" Style="{StaticResource Label}" Margin="0,26,0,8"/>
              <WrapPanel x:Name="LangChips" MaxWidth="720" HorizontalAlignment="Left"/>
            </StackPanel>
          </ScrollViewer>

          <!-- ============ MODS ============ -->
          <ScrollViewer x:Name="PageMods" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
            <StackPanel>
              <TextBlock x:Name="ModsTitle" Style="{StaticResource Title}"/>
              <TextBlock x:Name="ModsHelp" Style="{StaticResource Help}" FontSize="14" MaxWidth="680" HorizontalAlignment="Left"/>
              <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MinWidth="420">
                <StackPanel>
                  <TextBlock x:Name="ModsNumber" Foreground="{StaticResource Ink}" FontSize="40" FontWeight="Light"/>
                  <TextBlock x:Name="ModsCaption" Foreground="{StaticResource Muted}" FontSize="14"/>
                </StackPanel>
              </Border>
              <StackPanel x:Name="ModsList" Margin="0,18,0,0"/>
              <WrapPanel Margin="0,20,0,0"><Button x:Name="ModsOpen" Style="{StaticResource AccentBtn}"/><Button x:Name="ModsFolder" Style="{StaticResource Soft}" Margin="0"/></WrapPanel>
              <TextBlock x:Name="ModsOnline" Style="{StaticResource Help}" MaxWidth="660" HorizontalAlignment="Left" Margin="0,18,0,0"/>
            </StackPanel>
          </ScrollViewer>

          <!-- ============ SHADERS ============ -->
          <StackPanel x:Name="PageShaders" Visibility="Collapsed">
            <TextBlock x:Name="ShadersTitle" Style="{StaticResource Title}"/>
            <TextBlock x:Name="ShadersHelp" Style="{StaticResource Help}" MaxWidth="680" HorizontalAlignment="Left" FontSize="14"/>
            <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MinWidth="520">
              <StackPanel>
                <StackPanel Orientation="Horizontal"><Ellipse x:Name="ShaderDot" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0" Fill="{StaticResource Good}"/>
                  <TextBlock x:Name="ShaderState" Foreground="{StaticResource Ink}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                <TextBlock x:Name="ShaderCaption" Foreground="{StaticResource Muted}" FontSize="13" Margin="20,4,0,0" TextWrapping="Wrap" MaxWidth="560"/>
                <StackPanel x:Name="ShaderRun" Visibility="Collapsed" Margin="0,20,0,0">
                  <ProgressBar x:Name="ShaderBar" Style="{StaticResource Bar}" Maximum="1000"/>
                  <Grid Margin="0,10,0,0"><TextBlock x:Name="ShaderDetail" Foreground="{StaticResource Ink}" FontSize="13"/>
                    <TextBlock x:Name="ShaderEta" Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Right"/></Grid>
                </StackPanel>
              </StackPanel>
            </Border>
            <WrapPanel Margin="0,24,0,0"><Button x:Name="PrepareBtn" Style="{StaticResource AccentBtn}"/><Button x:Name="StopShaders" Style="{StaticResource Soft}" Visibility="Collapsed" Margin="0"/></WrapPanel>
            <TextBlock x:Name="ShadersNote" Style="{StaticResource Help}" MaxWidth="660" HorizontalAlignment="Left" Margin="0,14,0,0"/>
          </StackPanel>

          <!-- ============ GAME ============ -->
          <ScrollViewer x:Name="PageGame" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
            <StackPanel>
              <TextBlock x:Name="GameTitle" Style="{StaticResource Title}"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="UpdTitle" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="UpdStatus" Foreground="{StaticResource Ink}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="660" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="UpdDetail" Style="{StaticResource Help}" MaxWidth="660" HorizontalAlignment="Left"/>
                  <StackPanel x:Name="UpdRun" Visibility="Collapsed" Margin="0,14,0,0">
                    <ProgressBar x:Name="UpdBar" Style="{StaticResource Bar}" Maximum="1000" IsIndeterminate="False"/>
                    <TextBlock x:Name="UpdLine" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                  <WrapPanel Margin="0,16,0,0"><Button x:Name="UpdCheckBtn" Style="{StaticResource Soft}"/><Button x:Name="UpdNowBtn" Style="{StaticResource AccentBtn}" Visibility="Collapsed" Margin="0,0,10,10"/></WrapPanel>
                  <TextBlock x:Name="ThisCopy" Style="{StaticResource Help}" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="ToolsTitle" Style="{StaticResource CardTitle}"/>
                  <WrapPanel Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left">
                    <Button x:Name="RepairBtn" Style="{StaticResource Soft}"/><Button x:Name="UnlockBtn" Style="{StaticResource Soft}"/>
                    <Button x:Name="FolderBtn" Style="{StaticResource Soft}"/><Button x:Name="LogBtn" Style="{StaticResource Soft}"/>
                    <Button x:Name="ReportsBtn" Style="{StaticResource Soft}"/><Button x:Name="OpenSmashBtn" Style="{StaticResource Soft}"/>
                  </WrapPanel>
                  <TextBlock x:Name="ToolsNote" Style="{StaticResource Help}" MaxWidth="660" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- a short message at the bottom -->
          <Border x:Name="ToastBox" Visibility="Collapsed" Panel.ZIndex="8" VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="14" Background="#F01A1F3D" BorderBrush="#55A66BFF" BorderThickness="1" Padding="18,12" Margin="0,0,0,-8">
            <TextBlock x:Name="ToastText" Foreground="{StaticResource Ink}" FontSize="14" TextWrapping="Wrap" MaxWidth="640"/></Border>

          <!-- while the game starts -->
          <Grid x:Name="Starting" Visibility="Collapsed" Panel.ZIndex="9" Background="#E6080A15" Margin="-44,-38,-40,-30">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock x:Name="StartingText" Foreground="{StaticResource Ink}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock x:Name="StartingSub" Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
              <ProgressBar x:Name="StartBar" Style="{StaticResource Bar}" Width="300" Height="4" Margin="0,26,0,0" Maximum="1000"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
